rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/strategyDashboards/{dashboardId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && request.resource.data.dataRevision == 1;
      allow update: if isOwner(userId)
                    && (
                      (!('dataRevision' in resource.data) && request.resource.data.dataRevision == 1) ||
                      (('dataRevision' in resource.data) && request.resource.data.dataRevision == resource.data.dataRevision + 1)
                    );
      allow delete: if isOwner(userId);

      // 永久策略紀錄、automationTests 等子集合仍限定同一 UID。
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
